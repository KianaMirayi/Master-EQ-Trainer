rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidPlayerStats(stats) {
      return stats is map &&
             stats.levelsPlayed is number &&
             stats.levelsCompleted is number &&
             stats.totalStars is number &&
             stats.totalTimeSpent is number &&
             stats.retriesCount is number &&
             stats.totalFreqError is number &&
             stats.totalQError is number &&
             stats.totalGainError is number &&
             stats.extremeGainCount is number &&
             stats.totalUserQSum is number &&
             stats.totalSweepEvents is number;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.displayName is string &&
             data.uid == request.auth.uid &&
             isValidPlayerStats(data.stats);
    }

    function isValidScore(data) {
      return data.uid is string &&
             data.displayName is string &&
             data.uid == request.auth.uid &&
             data.masteryScore is number &&
             data.ami is number &&
             data.levelsCompleted is number;
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['stats', 'updatedAt', 'displayName', 'photoURL'])
      );
    }

    // Leaderboard collection
    match /leaderboard/{userId} {
      allow get: if true;
      allow list: if true; // Public leaderboard
      allow create: if isOwner(userId) && isValidScore(incoming());
      allow update: if isOwner(userId) && isValidScore(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['masteryScore', 'ami', 'levelsCompleted', 'updatedAt', 'displayName', 'photoURL'])
      );
    }
  }
}
